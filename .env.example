# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  (คำสั่ง: copy .env.example .env)
# ไฟล์ .env จริงถูก gitignore ไว้ — อย่า commit และอย่าแชร์ให้ใคร

# Telegram bot token ของคุณเอง — สร้างจาก @BotFather ใน Telegram
# หมายเหตุ: แต่ละคน/แต่ละเครื่องต้องใช้ token ของตัวเอง ห้ามใช้ตัวเดียวกันซ้ำ
BOT_TOKEN=

# (ไม่บังคับ) โฟลเดอร์ parquet cache ของโปรเจกต์ Trading_Dashboard
# ใช้สำหรับ "โหมดสแกนทั้งตลาด" — เว้นว่างได้ ระบบจะถอยไปใช้โหมดรายชื่อหลัก
# (scan_universe.txt) แทนโดยอัตโนมัติ
# ตัวอย่าง Windows: C:\Users\ชื่อคุณ\Desktop\Dashboard\Trading_Dashboard\data_cache\TH
# ตัวอย่าง Linux/VPS: /home/user/Trading_Dashboard/data_cache/TH
DASHBOARD_TH_CACHE=

# ── คำสั่ง "วิเคราะห์ XXX" / ปุ่ม 📐 (ข้อมูล PHASE 0 สำหรับ Gem เทคนิค) ─────────
# บอทอ่าน payload ที่ dashboard สร้างไว้ (site/data/manifest.json → data/<build>/stocks-TH.json)
# แล้วประกอบข้อความชุดเดียวกับปุ่ม 📐 บนเว็บ dashboard ให้กดคัดลอกจาก Telegram ได้

# (ไม่บังคับ) โฟลเดอร์ site ของโปรเจกต์ Trading_Dashboard ในเครื่องเดียวกัน — อ่านไฟล์ตรง เร็วสุด
# เว้นว่าง = ข้ามไปอ่านจากเว็บ DASHBOARD_URL แทน
# ตัวอย่าง Windows: C:\Users\ชื่อคุณ\Desktop\Dashboard\Trading_Dashboard\site
DASHBOARD_SITE_DIR=

# URL ของ dashboard ที่ deploy ไว้ (ต้นทางสำรอง — ใช้เมื่อไม่มีโฟลเดอร์ในเครื่อง หรือข้อมูลในเครื่องเก่ากว่า 5 วัน)
# ค่าเริ่มต้นถ้าเว้นว่าง: https://sakura.peodbot.com
DASHBOARD_URL=

# ลิงก์ Gem เทคนิคของคุณเอง (รูปแบบ https://gemini.google.com/gem/xxxxxxxx) — ปุ่ม "📐 เปิด Gem เทคนิค"
# Gem ผูกกับบัญชี Google รายคน จึงเก็บใน .env เท่านั้น ห้ามใส่ลงโค้ด/เอกสาร
# เว้นว่าง = เปิดหน้ารายการ Gems (https://gemini.google.com/gems/view) ให้เลือกเอง
GEM_TA_URL=
